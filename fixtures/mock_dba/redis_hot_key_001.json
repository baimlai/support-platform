  "scenario": {
    "label": "Redis 单分片热 Key 导致延迟升高",
    "search_query": "Redis 热key 访问次数 分片 CPU slowlog 内存",
    "steps": [
      {
        "tool": "redis_key_stats",
        "label": "访问次数最高的 Key",
        "args": {
          "instance_id": "$instance_id",
          "limit": 10
        },
        "reason": "先统计访问次数最高的 Key，确认是否存在明显高于其他 Key 的热点，以及热点落在哪个分片。"
      },
      {
        "tool": "redis_info",
        "label": "各分片 CPU 与吞吐",
        "args": {
          "instance_id": "$instance_id",
          "section": "all"
        },
        "reason": "热 Key 只有和分片资源对上才能解释延迟，继续查各分片 CPU、op/s、连接数和内存。"
      },
      {
        "tool": "redis_slowlog",
        "label": "慢命令与延迟",
        "args": {
          "instance_id": "$instance_id",
          "limit": 10
        },
        "reason": "最后查 SLOWLOG，确认热点命令的实际耗时和服务端排队情况。"
      }
    ],
    "diagnosis": {
      "root_cause": "商品详情接口对同一个活动配置 Key `promo:2026:home:banner` 持续执行 GET，约 82000 QPS 全部落到分片 3；该分片 CPU 达到 94%，请求在服务端排队，导致商品详情 p99 升高。这不是集群整体内存或网络问题。",
      "confidence": "高",
      "evidence_keys": [
        "redis.hot_key",
        "redis.shard.cpu",
        "redis.slowlog.get"
      ],
      "boundary": "当前能定位到热 Key 和单分片 CPU，但未查看客户端连接池和代理路由配置；修复后仍需验证流量是否均匀。",
      "fix": {
        "primary": [
          "在商品详情服务增加本地缓存（例如 1~5 秒 TTL），把同一活动配置的重复 GET 挡在 Redis 之前。",
          "评估把热点 Key 拆成多个副本 Key（例如 `promo:2026:home:banner:{0..9}`），由客户端随机读，分散单分片压力。",
          "读多写少的活动配置可以使用只读副本或专门缓存层，避免所有请求集中到一个主分片。"
        ],
        "alternate": [
          "如果业务允许，把活动配置推送到 CDN 或应用配置中心，减少 Redis 读放大。",
          "短期扩容分片 3 所在节点，但热点 Key 不拆分时扩容收益有限。"
        ],
        "mitigation": [
          "对商品详情接口限流，优先保护下单链路。",
          "临时把活动配置的 TTL 调长，减少回源，但不能解决单 Key 热点的 CPU 消耗。"
        ]
      },
      "excluded": [
        "Redis 内存不足：INFO 显示 used_memory 约 6.2GB / 8GB，没有触发 maxmemory 淘汰。",
        "集群网络故障：三个分片都能响应，延迟集中在分片 3 的 CPU，不是网络超时。"
      ],
      "pending": [
        "需要确认客户端是否使用集群代理，以及代理是否支持按 Key 后缀打散。",
        "需要确认活动配置变更频率，决定本地缓存 TTL 的上限。"
      ],
      "verification": [
        "上线本地缓存或 Key 拆分后，观察分片 3 CPU 是否降到 60% 以下、其他分片是否分担流量。",
        "对比商品详情接口 p99 和 Redis GET 的 QPS。",
        "检查 SLOWLOG 是否还持续出现同一个 Key 的慢命令。"
      ],
      "limitations": [
        "没有采集客户端侧连接池和超时配置，无法判断重试放大了多少流量。",
        "热 Key 统计来自模拟采样，真实环境应使用 `HOTKEYS` 或代理监控交叉确认。"
      ]
    }
  },
