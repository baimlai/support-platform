  "scenario": {
    "label": "MongoDB 缺少复合索引导致全集合扫描",
    "search_query": "MongoDB profiler COLLSCAN 慢查询 explain 复合索引 orders",
    "steps": [
      {
        "tool": "mongo_profiler",
        "label": "Profiler 中的慢操作",
        "args": {
          "instance_id": "$instance_id",
          "start_time": "$start_time",
          "end_time": "$end_time",
          "min_duration_ms": 500,
          "limit": 10
        },
        "reason": "先从 profiler 找耗时超过 500ms 的操作，看慢查询的集合、过滤条件、扫描文档数和执行计划摘要。"
      },
      {
        "tool": "mongo_explain",
        "label": "慢查询执行计划",
        "args": {
          "instance_id": "$instance_id",
          "database": "commerce",
          "collection": "orders",
          "filter_json": "{\"status\":\"PENDING\",\"createdAt\":{\"$gte\":\"2026-09-01T00:00:00Z\"}}"
        },
        "reason": "profiler 显示 COLLSCAN 后，对同一条查询执行 explain，确认 winningPlan、扫描文档数和可用索引，判断是不是缺少索引。"
      },
      {
        "tool": "mongo_server_status",
        "label": "主节点资源使用",
        "args": {
          "instance_id": "$instance_id"
        },
        "reason": "最后查 serverStatus，确认 CPU、WiredTiger cache 和磁盘 IO 是否被全集合扫描拖高，排除其他资源瓶颈。"
      }
    ],
    "diagnosis": {
      "root_cause": "运营后台按 `status` 和 `createdAt` 筛选订单，但 `commerce.orders` 只有 `_id` 索引，没有 `{status: 1, createdAt: -1}` 复合索引；查询退化成 COLLSCAN，每次扫描约 284 万份文档只返回 50 条，单次约 1.8 秒，并把主节点 CPU 推到 87%。",
      "confidence": "高",
      "evidence_keys": [
        "mongo.profiler.collscan",
        "mongo.explain.index_gap",
        "mongo.server.cpu"
      ],
      "boundary": "当前能确认执行计划和索引缺口，但尚未在线上创建索引；真实变更需要评估索引构建期间的 IO 和磁盘空间。",
      "fix": {
        "primary": [
          "在 `commerce.orders` 上创建复合索引 `{status: 1, createdAt: -1}`，让筛选和按时间倒序共用同一个索引；先在从节点或测试环境验证执行计划。",
          "把运营后台查询改为强制分页（例如每页 50 条）并带上时间范围，避免一次扫描过大区间。",
          "上线后再次执行 explain，确认 winningPlan 从 COLLSCAN 变为 IXSCAN，docsExamined 接近 nReturned。"
        ],
        "alternate": [
          "如果还会按商家维度筛选，评估扩展为 `{merchantId: 1, status: 1, createdAt: -1}`，但要注意索引前缀和写入成本。",
          "对历史订单按时间归档，减少单集合文档总量。"
        ],
        "mitigation": [
          "短期对运营后台的订单筛选接口限流或加缓存，降低主节点压力。",
          "在低峰期构建索引，并监控 WiredTiger cache 和磁盘 IO；必要时使用滚动方式在从节点先建。"
        ]
      },
      "excluded": [
        "索引存在但未被使用：explain 显示集合只有 `_id` 索引，不存在可用的状态/时间索引。",
        "内存不足：WiredTiger cache 使用率约 68%，没有频繁 eviction，慢在扫描量而不是缓存换出。",
        "磁盘 IO 饱和：磁盘利用率约 41%，CPU 升高是扫描大量文档的结果。"
      ],
      "pending": [
        "需要确认运营后台是否还有按其他字段组合筛选的查询，避免只建一个索引覆盖不全。",
        "需要确认订单集合的写入量，评估新增索引对写入延迟的影响。"
      ],
      "verification": [
        "创建索引后重新执行 explain，确认使用 IXSCAN 且 docsExamined 从百万级降到几十条。",
        "观察 profiler 中该查询的耗时是否从 1.8 秒降到 50ms 以内。",
        "对比主节点 CPU 和磁盘读 IOPS 是否回落。"
      ],
      "limitations": [
        "profiler 数据来自模拟采样，只保留代表性慢操作。",
        "没有拿到运营后台的实际查询代码，过滤条件根据 profiler 还原。"
      ]
    }
  },
